# Application
APP_NAME=High-Concurrency Flash Sale API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/flash_sale_db

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_LOCK_EXPIRE=5

# JWT
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
